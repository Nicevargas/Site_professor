# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION
# Set your Supabase Project URL and Anon/Public API Key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ENDEREÇO DAS VITRINES
#
# VITE_PLATFORM_HOST: o domínio-RAIZ, de onde pendem os subdomínios dos
# professores. Precisa ser a raiz mesmo: o endereço fica a um nível dele
# (renato.aquagenda.com.br), e dois níveis são recusados de propósito.
# Vazio, o endereçamento por subdomínio e por domínio próprio não funciona.
VITE_PLATFORM_HOST=

# VITE_APP_HOST: onde o app está realmente servido, para o endereço por
# caminho (dominio.com/p/<slug>).
#
# Só é necessário quando a RAIZ do domínio acima não é o Aquagenda -- caso
# em que o link do plano Start abriria o outro sistema, e com HTTP 200,
# porque ele responde qualquer caminho. Vazio, vale o VITE_PLATFORM_HOST.
VITE_APP_HOST=

# AUTOMAÇÕES
# Webhook do n8n para os lembretes de aula. Lido em utils/webhookDispatcher.
VITE_N8N_WEBHOOK_URL=
